{
  "name": "lift-coach",
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/copy-mediapipe.mjs",
    "build": "tsc && vite build",
    "postinstall": "node scripts/copy-mediapipe.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:all": "vitest run && playwright test",
    "validate": "tsc --noEmit && vitest run && vite build",
    "ios:build": "npm run build && npx cap sync ios",
    "ios:open": "npx cap open ios",
    "ios:run": "npm run build && npx cap sync ios && npx cap run ios"
  },
  "dependencies": {
    "@capacitor/camera": "^8.0.2",
    "@capacitor/cli": "^8.2.0",
    "@capacitor/core": "^8.2.0",
    "@capacitor/haptics": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.1",
    "@mediapipe/tasks-vision": "^0.10.0"
  },
  "devDependencies": {
    "@capacitor-firebase/authentication": "^8.1.0",
    "@capacitor-firebase/firestore": "^8.1.0",
    "@capacitor-firebase/storage": "^8.1.0",
    "@playwright/test": "^1.58.2",
    "firebase": "^12.11.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vitest": "^4.0.18"
  }
}
